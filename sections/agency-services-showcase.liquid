{% liquid
  assign whatsapp_phone = section.settings.whatsapp_phone | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign first_category = 'industrial'
%}

<section
  class="agency-services color-{{ section.settings.color_scheme }}"
  id="agency-services-{{ section.id }}"
  data-agency-services
  style="
    --agency-accent: {{ section.settings.accent_color }};
    --agency-accent-contrast: {{ section.settings.accent_text_color }};
  "
>
  <div class="agency-services__inner page-width">
    <div class="agency-services__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="agency-services__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="agency-services__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.intro != blank %}
          <div class="agency-services__intro rte">{{ section.settings.intro }}</div>
        {% endif %}
      </div>
      <div class="agency-services__header-note">
        <span class="agency-services__status-dot"></span>
        <span>{{ section.settings.header_note | escape }}</span>
      </div>
    </div>

    <div class="agency-services__tabs" role="tablist" aria-label="{{ section.settings.tab_label | escape }}">
      {% assign categories = 'industrial,development,design,automation' | split: ',' %}
      {% for category in categories %}
        {% case category %}
          {% when 'industrial' %}
            {% assign category_label = section.settings.category_1_label %}
          {% when 'development' %}
            {% assign category_label = section.settings.category_2_label %}
          {% when 'design' %}
            {% assign category_label = section.settings.category_3_label %}
          {% when 'automation' %}
            {% assign category_label = section.settings.category_4_label %}
        {% endcase %}
        <button
          class="agency-services__tab{% if category == first_category %} is-active{% endif %}"
          type="button"
          role="tab"
          aria-selected="{% if category == first_category %}true{% else %}false{% endif %}"
          aria-controls="agency-services-panel-{{ section.id }}-{{ category }}"
          data-category-tab="{{ category }}"
        >
          <span class="agency-services__tab-index">0{{ forloop.index }}</span>
          <span>{{ category_label | escape }}</span>
        </button>
      {% endfor %}
    </div>

    {% assign visible_count = 0 %}
    <div class="agency-services__panels">
      {% for category in categories %}
        <div
          class="agency-services__panel{% if category == first_category %} is-active{% endif %}"
          id="agency-services-panel-{{ section.id }}-{{ category }}"
          role="tabpanel"
          data-category-panel="{{ category }}"
          {% unless category == first_category %}hidden{% endunless %}
        >
          <div class="agency-services__grid">
            {% for block in section.blocks %}
              {% if block.settings.category == category %}
                {% assign visible_count = visible_count | plus: 1 %}
                {% assign selected_product = block.settings.product %}
                {% assign service_message = 'Hello, I am interested in ' | append: block.settings.title | append: '. Please share availability and next steps.' %}
                {% assign encoded_message = service_message | url_encode %}
                <article class="agency-service-card" {{ block.shopify_attributes }}>
                  <div class="agency-service-card__topline">
                    <span class="agency-service-card__badge">{{ block.settings.badge | escape }}</span>
                    {% if block.settings.delivery_time != blank %}
                      <span class="agency-service-card__delivery">{{ block.settings.delivery_time | escape }}</span>
                    {% endif %}
                  </div>
                  <div class="agency-service-card__content">
                    <h3 class="agency-service-card__title">{{ block.settings.title | escape }}</h3>
                    <p class="agency-service-card__description">{{ block.settings.description | escape }}</p>
                    {% if block.settings.tech_stack != blank %}
                      <div class="agency-service-card__stack" aria-label="{{ section.settings.tech_label | escape }}">
                        {% assign tech_items = block.settings.tech_stack | split: ',' %}
                        {% for tech in tech_items %}
                          <span class="agency-service-card__tech">{{ tech | strip | escape }}</span>
                        {% endfor %}
                      </div>
                    {% endif %}
                    <div class="agency-service-card__price">
                      <span>{{ section.settings.price_label | escape }}</span>
                      <strong>{{ block.settings.price | escape }}</strong>
                    </div>
                    <ul class="agency-service-card__deliverables">
                      {% if block.settings.deliverable_1 != blank %}<li>{{ block.settings.deliverable_1 | escape }}</li>{% endif %}
                      {% if block.settings.deliverable_2 != blank %}<li>{{ block.settings.deliverable_2 | escape }}</li>{% endif %}
                      {% if block.settings.deliverable_3 != blank %}<li>{{ block.settings.deliverable_3 | escape }}</li>{% endif %}
                    </ul>
                  </div>
                  <div class="agency-service-card__actions">
                    {% if selected_product != blank and selected_product.selected_or_first_available_variant != blank %}
                      {% assign service_variant = selected_product.selected_or_first_available_variant %}
                      {% form 'product', selected_product, class: 'agency-service-card__form' %}
                        <input type="hidden" name="id" value="{{ service_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button class="agency-service-card__order button" type="submit" {% unless service_variant.available %}disabled{% endunless %}>
                          {% if service_variant.available %}{{ block.settings.order_label | escape }}{% else %}{{ section.settings.sold_out_label | escape }}{% endif %}
                          <span aria-hidden="true">&#8594;</span>
                        </button>
                      {% endform %}
                    {% else %}
                      <a class="agency-service-card__order button" href="{{ section.settings.quote_url | default: '/pages/contact' }}">
                        {{ block.settings.order_label | escape }} <span aria-hidden="true">&#8594;</span>
                      </a>
                    {% endif %}
                    <a
                      class="agency-service-card__whatsapp"
                      href="https://wa.me/{{ whatsapp_phone }}?text={{ encoded_message }}"
                      target="_blank"
                      rel="noopener"
                    >
                      <span class="agency-service-card__whatsapp-icon" aria-hidden="true">&#9679;</span>
                      {{ block.settings.whatsapp_label | escape }}
                    </a>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="agency-services__trust" aria-label="{{ section.settings.trust_label | escape }}">
      {% assign trust_items = section.settings.trust_items | split: '|' %}
      {% for item in trust_items %}
        <span class="agency-services__trust-item"><span aria-hidden="true">&#10003;</span>{{ item | strip | escape }}</span>
      {% endfor %}
    </div>

    <div class="agency-services__quote">
      <div>
        <p class="agency-services__quote-kicker">{{ section.settings.quote_kicker | escape }}</p>
        <h3>{{ section.settings.quote_heading | escape }}</h3>
        <p>{{ section.settings.quote_text | escape }}</p>
      </div>
      <a class="agency-services__quote-button button" href="{{ section.settings.quote_url | default: '/pages/contact' }}">
        {{ section.settings.quote_button | escape }} <span aria-hidden="true">&#8594;</span>
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .agency-services {
    --agency-surface: #111a24;
    --agency-surface-raised: #172331;
    --agency-border: rgb(255 255 255 / 14%);
    --agency-muted: #9eabb8;
    background: #0b1118;
    color: #f4f7f9;
    padding: 76px 0 88px;
  }

  .agency-services__inner { max-width: 1440px; margin: 0 auto; padding: 0 5vw; }
  .agency-services__header { display: flex; align-items: end; justify-content: space-between; gap: 32px; margin-bottom: 42px; }
  .agency-services__eyebrow, .agency-services__quote-kicker { color: var(--agency-accent); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; margin: 0 0 12px; text-transform: uppercase; }
  .agency-services__heading { font-size: clamp(2rem, 4vw, 4.25rem); letter-spacing: 0; line-height: 0.98; margin: 0; max-width: 760px; }
  .agency-services__intro { color: var(--agency-muted); margin-top: 18px; max-width: 640px; }
  .agency-services__header-note { align-items: center; color: var(--agency-muted); display: flex; font-size: 0.85rem; gap: 9px; white-space: nowrap; }
  .agency-services__status-dot { background: #55d69a; border-radius: 50%; box-shadow: 0 0 0 5px rgb(85 214 154 / 12%); height: 8px; width: 8px; }
  .agency-services__tabs { border-bottom: 1px solid var(--agency-border); display: flex; gap: 8px; margin-bottom: 28px; overflow-x: auto; scrollbar-width: none; }
  .agency-services__tab { align-items: center; background: none; border: 0; border-bottom: 2px solid transparent; color: var(--agency-muted); cursor: pointer; display: flex; flex: 0 0 auto; font: inherit; gap: 10px; padding: 0 16px 17px; text-align: left; }
  .agency-services__tab:hover, .agency-services__tab.is-active { color: #fff; }
  .agency-services__tab.is-active { border-bottom-color: var(--agency-accent); }
  .agency-services__tab-index { color: var(--agency-accent); font-size: 0.7rem; font-weight: 700; }
  .agency-services__panel[hidden] { display: none; }
  .agency-services__grid { display: grid; gap: 18px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .agency-service-card { background: var(--agency-surface); border: 1px solid var(--agency-border); display: flex; flex-direction: column; min-height: 100%; padding: 24px; transition: border-color 180ms ease, transform 180ms ease; }
  .agency-service-card:hover { border-color: var(--agency-accent); transform: translateY(-3px); }
  .agency-service-card__topline, .agency-service-card__price { align-items: center; display: flex; justify-content: space-between; gap: 12px; }
  .agency-service-card__badge { color: var(--agency-accent); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .agency-service-card__delivery { color: var(--agency-muted); font-size: 0.75rem; }
  .agency-service-card__content { flex: 1; }
  .agency-service-card__title { font-size: 1.35rem; letter-spacing: 0; line-height: 1.15; margin: 30px 0 10px; }
  .agency-service-card__description { color: var(--agency-muted); font-size: 0.9rem; line-height: 1.55; margin: 0 0 18px; }
  .agency-service-card__stack { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 24px; }
  .agency-service-card__tech { border: 1px solid var(--agency-border); color: #d6dee5; font-size: 0.7rem; padding: 5px 8px; }
  .agency-service-card__price { border-bottom: 1px solid var(--agency-border); border-top: 1px solid var(--agency-border); padding: 14px 0; }
  .agency-service-card__price span { color: var(--agency-muted); font-size: 0.75rem; }
  .agency-service-card__price strong { color: var(--agency-accent); font-size: 1.05rem; }
  .agency-service-card__deliverables { color: #dfe6eb; font-size: 0.85rem; line-height: 1.45; list-style: none; margin: 18px 0 26px; padding: 0; }
  .agency-service-card__deliverables li { margin-bottom: 8px; padding-left: 18px; position: relative; }
  .agency-service-card__deliverables li::before { color: var(--agency-accent); content: '\2713'; left: 0; position: absolute; }
  .agency-service-card__actions { display: grid; gap: 9px; }
  .agency-service-card__form { display: block; }
  .agency-service-card__order, .agency-services__quote-button { align-items: center; background: var(--agency-accent); border: 1px solid var(--agency-accent); color: var(--agency-accent-contrast); display: flex; font-size: 0.85rem; font-weight: 700; justify-content: space-between; padding: 13px 15px; text-decoration: none; width: 100%; }
  .agency-service-card__order:hover, .agency-services__quote-button:hover { filter: brightness(1.1); }
  .agency-service-card__whatsapp { align-items: center; border: 1px solid var(--agency-border); color: #e8eef2; display: flex; font-size: 0.78rem; gap: 8px; justify-content: center; padding: 11px 15px; text-decoration: none; }
  .agency-service-card__whatsapp:hover { border-color: #55d69a; color: #55d69a; }
  .agency-service-card__whatsapp-icon { color: #55d69a; font-size: 0.7rem; }
  .agency-services__trust { border-bottom: 1px solid var(--agency-border); border-top: 1px solid var(--agency-border); display: flex; flex-wrap: wrap; gap: 18px 34px; justify-content: center; margin-top: 56px; padding: 20px 0; }
  .agency-services__trust-item { align-items: center; color: #d3dce3; display: flex; font-size: 0.78rem; gap: 8px; }
  .agency-services__trust-item span { color: var(--agency-accent); font-weight: 700; }
  .agency-services__quote { align-items: center; background: var(--agency-surface-raised); border-left: 3px solid var(--agency-accent); display: flex; gap: 30px; justify-content: space-between; margin-top: 32px; padding: 30px 34px; }
  .agency-services__quote h3 { font-size: clamp(1.45rem, 2.3vw, 2.2rem); letter-spacing: 0; margin: 0 0 7px; }
  .agency-services__quote p:last-child { color: var(--agency-muted); margin: 0; }
  .agency-services__quote-button { flex: 0 0 auto; width: auto; }

  @media screen and (max-width: 900px) { .agency-services__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media screen and (max-width: 640px) {
    .agency-services { padding: 52px 0 60px; }
    .agency-services__inner { padding: 0 20px; }
    .agency-services__header { align-items: start; flex-direction: column; gap: 20px; margin-bottom: 30px; }
    .agency-services__grid { grid-template-columns: 1fr; }
    .agency-services__tab { padding-inline: 10px; }
    .agency-services__quote { align-items: stretch; flex-direction: column; padding: 24px; }
    .agency-services__quote-button { justify-content: space-between; width: 100%; }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-agency-services]').forEach((section) => {
    const tabs = section.querySelectorAll('[data-category-tab]');
    const panels = section.querySelectorAll('[data-category-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const category = tab.dataset.categoryTab;
        tabs.forEach((item) => {
          const isActive = item === tab;
          item.classList.toggle('is-active', isActive);
          item.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        panels.forEach((panel) => {
          const isActive = panel.dataset.categoryPanel === category;
          panel.classList.toggle('is-active', isActive);
          panel.hidden = !isActive;
        });
      });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Agency services showcase",
  "tag": "section",
  "class": "section-agency-services-showcase",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Technical services, built to ship" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Turn complex ideas into working systems." },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Choose a ready-to-order service or speak directly with the engineer who will build it.</p>" },
    { "type": "text", "id": "header_note", "label": "Header status note", "default": "Accepting new projects this month" },
    { "type": "text", "id": "tab_label", "label": "Tab group label", "default": "Browse services by discipline" },
    { "type": "text", "id": "category_1_label", "label": "Category 1 label", "default": "Industrial & hardware" },
    { "type": "text", "id": "category_2_label", "label": "Category 2 label", "default": "Web & mobile apps" },
    { "type": "text", "id": "category_3_label", "label": "Category 3 label", "default": "Design & digital assets" },
    { "type": "text", "id": "category_4_label", "label": "Category 4 label", "default": "Python & automation" },
    { "type": "text", "id": "price_label", "label": "Price label", "default": "Starting from" },
    { "type": "text", "id": "tech_label", "label": "Technology list label", "default": "Built with" },
    { "type": "text", "id": "sold_out_label", "label": "Unavailable product label", "default": "Currently unavailable" },
    { "type": "text", "id": "whatsapp_phone", "label": "WhatsApp number", "default": "923001234567", "info": "Include country code without +, spaces, or punctuation." },
    { "type": "url", "id": "quote_url", "label": "Quote destination" },
    { "type": "text", "id": "trust_label", "label": "Trust bar label", "default": "Why clients choose us" },
    { "type": "text", "id": "trust_items", "label": "Trust items", "default": "100% quality guarantee|Fast delivery|Direct technical support|Customized solutions", "info": "Separate each item with a | character." },
    { "type": "text", "id": "quote_kicker", "label": "Quote kicker", "default": "Need something tailored?" },
    { "type": "text", "id": "quote_heading", "label": "Quote heading", "default": "Let us scope your next build." },
    { "type": "textarea", "id": "quote_text", "label": "Quote text", "default": "Send your requirements and get a practical plan, timeline, and fixed quote." },
    { "type": "text", "id": "quote_button", "label": "Quote button label", "default": "Request a custom quote" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#f6c453" },
    { "type": "color", "id": "accent_text_color", "label": "Accent text color", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service card",
      "settings": [
        { "type": "select", "id": "category", "label": "Category", "options": [
          { "value": "industrial", "label": "Industrial & hardware" },
          { "value": "development", "label": "Web & mobile apps" },
          { "value": "design", "label": "Design & digital assets" },
          { "value": "automation", "label": "Python & automation" }
        ], "default": "industrial" },
        { "type": "text", "id": "badge", "label": "Category badge", "default": "PLC / IoT" },
        { "type": "text", "id": "title", "label": "Service title", "default": "PLC & industrial automation" },
        { "type": "textarea", "id": "description", "label": "Value description", "default": "Reliable control logic and connected hardware that keeps your operation moving." },
        { "type": "text", "id": "tech_stack", "label": "Technology stack", "default": "Fatek, WinProladder, VFD, RS485", "info": "Separate technologies with commas." },
        { "type": "text", "id": "price", "label": "Starting price", "default": "$49 / PKR 15,000" },
        { "type": "text", "id": "delivery_time", "label": "Delivery time", "default": "3-7 days" },
        { "type": "text", "id": "deliverable_1", "label": "Deliverable 1", "default": "Requirements review" },
        { "type": "text", "id": "deliverable_2", "label": "Deliverable 2", "default": "Working implementation" },
        { "type": "text", "id": "deliverable_3", "label": "Deliverable 3", "default": "Handover and support" },
        { "type": "product", "id": "product", "label": "Checkout product", "info": "Select a Shopify product to enable direct add to cart. Leave blank to link to the quote destination." },
        { "type": "text", "id": "order_label", "label": "Order button label", "default": "Order now" },
        { "type": "text", "id": "whatsapp_label", "label": "WhatsApp button label", "default": "Instant WhatsApp consultation" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Agency services showcase",
      "blocks": [
        { "type": "service", "settings": { "category": "industrial", "badge": "PLC / VFD", "title": "PLC & industrial automation", "description": "Reliable control logic, VFD setup, and RS485 integration for production systems.", "tech_stack": "Fatek, WinProladder, VFD, RS485", "price": "$49 / PKR 15,000" } },
        { "type": "service", "settings": { "category": "industrial", "badge": "ARDUINO / IOT", "title": "Arduino & ESP32 prototyping", "description": "Turn sensors and connected hardware ideas into a testable IoT prototype.", "tech_stack": "Arduino, ESP32, Sensors, IoT", "price": "$79 / PKR 22,000" } },
        { "type": "service", "settings": { "category": "industrial", "badge": "REPAIR / FIRMWARE", "title": "Mobile board diagnostics", "description": "Structured diagnostics, firmware flashing, and repair guidance for mobile hardware.", "tech_stack": "ADB, UnlockTool, Firmware", "price": "$39 / PKR 12,000" } },
        { "type": "service", "settings": { "category": "development", "badge": "SHOPIFY / WEB", "title": "Conversion-ready web development", "description": "Fast, focused websites and Shopify storefronts built around a clear buying journey.", "tech_stack": "Shopify, WordPress, React, PHP", "price": "$149 / PKR 42,000" } },
        { "type": "service", "settings": { "category": "development", "badge": "FLUTTER / DART", "title": "Cross-platform mobile app", "description": "A practical Flutter app foundation that works across iOS and Android.", "tech_stack": "Flutter, Dart, REST API", "price": "$249 / PKR 70,000" } },
        { "type": "service", "settings": { "category": "development", "badge": "FUNNEL / CRO", "title": "Landing page & sales funnel", "description": "A focused landing experience with persuasive structure, tracking, and conversion points.", "tech_stack": "Liquid, HTML, CSS, CRO", "price": "$99 / PKR 28,000" } },
        { "type": "service", "settings": { "category": "design", "badge": "BRAND / UI", "title": "Branding and UI asset kit", "description": "A coherent visual system for your brand, dashboard, and customer-facing touchpoints.", "tech_stack": "Figma, Illustrator, Photoshop", "price": "$69 / PKR 20,000" } },
        { "type": "service", "settings": { "category": "design", "badge": "QR / PAYMENTS", "title": "QR & merchant payment setup", "description": "Clear QR assets and merchant payment flows that make it easier to get paid.", "tech_stack": "QR, Payment Gateway, Web", "price": "$49 / PKR 15,000" } },
        { "type": "service", "settings": { "category": "automation", "badge": "PYTHON / API", "title": "Workflow automation sprint", "description": "Remove repetitive work with reliable scripts, API connections, and GitHub workflows.", "tech_stack": "Python, REST API, GitHub", "price": "$89 / PKR 25,000" } },
        { "type": "service", "settings": { "category": "automation", "badge": "AI / AUDIO", "title": "AI content & speech scripts", "description": "Practical content engines and speech recognition workflows shaped around your process.", "tech_stack": "Python, AI, Speech API", "price": "$129 / PKR 36,000" } }
      ]
    }
  ]
}
{% endschema %}
