<section class="mrk-home">
  <div class="mrk-hero">
    <div class="mrk-container mrk-hero-grid">
      <div>
        <span class="mrk-eyebrow">MRK Digital Store</span>
        <h1>Digital Solutions, Products & Technology Services</h1>
        <p>Web & app development, graphic design, PLC & Arduino solutions, digital products and practical technology services — all in one place.</p>
        <div class="mrk-actions">
          <a class="mrk-btn mrk-btn-primary" href="{{ routes.all_products_collection_url }}">Explore Store</a>
          <a class="mrk-btn mrk-btn-secondary" href="/pages/contact">Contact MRK</a>
        </div>
      </div>
      <div class="mrk-hero-card">
        <strong>Build. Design. Automate.</strong>
        <p>Professional digital work for businesses, creators, students and technology projects.</p>
      </div>
    </div>
  </div>

  <div class="mrk-section">
    <div class="mrk-container">
      <div class="mrk-section-head">
        <div><h2>Our Services</h2><p>From websites and apps to automation and creative design.</p></div>
      </div>
      <div class="mrk-grid">
        <article class="mrk-card"><div class="mrk-card-icon">🌐</div><h3>Web Development</h3><p>Responsive business websites, stores, landing pages and custom web applications.</p></article>
        <article class="mrk-card"><div class="mrk-card-icon">📱</div><h3>App Development</h3><p>Practical mobile and software solutions designed around real user needs.</p></article>
        <article class="mrk-card"><div class="mrk-card-icon">⚙️</div><h3>PLC & Arduino</h3><p>Automation, controllers, sensors, relay systems and custom electronics projects.</p></article>
        <article class="mrk-card"><div class="mrk-card-icon">🎨</div><h3>Graphic Design</h3><p>Professional social posts, business cards, invitations, banners and digital graphics.</p></article>
        <article class="mrk-card"><div class="mrk-card-icon">💻</div><h3>Software Services</h3><p>Computer, website and software support with practical troubleshooting.</p></article>
        <article class="mrk-card"><div class="mrk-card-icon">🛒</div><h3>Digital Products</h3><p>Downloadable templates, guides, resources and project files for digital work.</p></article>
      </div>
    </div>
  </div>

  {% if collections.all.products_count > 0 %}
  <div class="mrk-section mrk-section-alt">
    <div class="mrk-container">
      <div class="mrk-section-head"><div><h2>Featured Products</h2><p>Explore the latest products and digital resources from MRK.</p></div><a class="mrk-btn mrk-btn-secondary" style="color:var(--mrk-navy);border-color:#cbd5e1" href="{{ routes.all_products_collection_url }}">View all</a></div>
      <div class="mrk-products">
        {% for product in collections.all.products limit:4 %}
          <article class="mrk-product">
            <a class="mrk-product-media" href="{{ product.url }}">
              {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | escape | default: product.title | escape }}" loading="lazy">{% endif %}
            </a>
            <div class="mrk-product-body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mrk-product-price">{{ product.price | money }}</div></div>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}

  <div class="mrk-section">
    <div class="mrk-container">
      <div class="mrk-project">
        <div>
          <span class="mrk-eyebrow">Featured Project</span>
          <h2>Automatic Water Tank Controller</h2>
          <p>Water level sensors → Arduino/ESP32 → Relay → Motor/Pump. Designed for automatic ON/OFF control, overflow protection, dry-run protection and manual control.</p>
          <a class="mrk-btn mrk-btn-primary" href="/pages/projects">View Projects</a>
        </div>
        <div class="mrk-project-diagram">Water Level Sensors<br>↓<br>Arduino / ESP32<br>↓<br>Relay Module<br>↓<br>Water Pump</div>
      </div>
    </div>
  </div>

  <div class="mrk-section mrk-section-alt">
    <div class="mrk-container">
      <div class="mrk-section-head"><div><h2>MRK Tech Blog</h2><p>Useful guides about websites, software, electronics, automation and digital earning.</p></div></div>
      <div class="mrk-blog-grid">
        {% for article in blogs.blog.articles limit:3 %}
          <article class="mrk-blog-card"><h3><a href="{{ article.url }}">{{ article.title }}</a></h3><p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p></article>
        {% else %}
          <article class="mrk-blog-card"><h3>Web Development Guides</h3><p>Practical website development and deployment tutorials.</p></article>
          <article class="mrk-blog-card"><h3>Arduino & PLC Projects</h3><p>Automation ideas, project breakdowns and implementation notes.</p></article>
          <article class="mrk-blog-card"><h3>Digital Earning</h3><p>Guides for freelancing, digital products and online business.</p></article>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="mrk-section">
    <div class="mrk-container">
      <div class="mrk-cta">
        <h2>Have a project in mind?</h2>
        <p>Tell MRK what you need — a website, app, design, automation project or digital product.</p>
        <a class="mrk-btn mrk-btn-primary" href="/pages/contact">Start a Project</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MRK Professional Home",
  "settings": []
}
{% endschema %}
